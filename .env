#This is just test data, for fast local deployment in docker-compose.
#In prod, these values should be stored in a secure values


# Security settings
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----
AUTH_ISSUER=auth-service
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=messenger

AUTH_DATASOURCE_URL=jdbc:postgresql://postgres:5432/auth_db
MESSAGE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/message_db

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redisSecurePassword123

#Minio settings
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin